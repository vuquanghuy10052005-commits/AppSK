<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <TextView
        android:id="@+id/tv_tieu_de"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/tieu_de_thong_ke"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/primary"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:tabTextColor="@color/text_secondary"
        app:tabSelectedTextColor="@color/primary"
        app:tabIndicatorColor="@color/primary"
        app:layout_constraintTop_toBottomOf="@id/tv_tieu_de"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tab_can_nang" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tab_van_dong" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tab_buoc_chan" />

    </com.google.android.material.tabs.TabLayout>

    <!-- Tab Cân nặng -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/khung_can_nang"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/tab_layout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.github.mikephil.charting.charts.LineChart
            android:id="@+id/bieu_do_can_nang"
            android:layout_width="0dp"
            android:layout_height="260dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tv_khong_co_du_lieu_can_nang"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/khong_co_du_lieu"
            android:textColor="@color/text_secondary"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/bieu_do_can_nang"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Tab Vận động -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/khung_van_dong"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tab_layout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.github.mikephil.charting.charts.BarChart
            android:id="@+id/bieu_do_van_dong"
            android:layout_width="0dp"
            android:layout_height="220dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tv_nhan_tong_quang_duong"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/nhan_tong_quang_duong_tuan"
            android:textColor="@color/text_secondary"
            app:layout_constraintTop_toBottomOf="@id/bieu_do_van_dong"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tv_gia_tri_tong_quang_duong"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            app:layout_constraintTop_toBottomOf="@id/tv_nhan_tong_quang_duong"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tv_nhan_so_buoi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/nhan_so_buoi_chay"
            android:textColor="@color/text_secondary"
            app:layout_constraintTop_toBottomOf="@id/tv_gia_tri_tong_quang_duong"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tv_gia_tri_so_buoi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            app:layout_constraintTop_toBottomOf="@id/tv_nhan_so_buoi"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tv_khong_co_du_lieu_van_dong"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/khong_co_du_lieu"
            android:textColor="@color/text_secondary"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/tv_gia_tri_so_buoi"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Tab Bước chân -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/khung_buoc_chan"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tab_layout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.github.mikephil.charting.charts.BarChart
            android:id="@+id/bieu_do_buoc_chan"
            android:layout_width="0dp"
            android:layout_height="240dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tv_nhan_hom_nay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/nhan_buoc_hom_nay"
            android:textColor="@color/text_secondary"
            app:layout_constraintTop_toBottomOf="@id/bieu_do_buoc_chan"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tv_gia_tri_hom_nay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            app:layout_constraintTop_toBottomOf="@id/tv_nhan_hom_nay"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tv_nhan_trung_binh_buoc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/nhan_buoc_trung_binh"
            android:textColor="@color/text_secondary"
            app:layout_constraintTop_toBottomOf="@id/tv_gia_tri_hom_nay"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tv_gia_tri_trung_binh_buoc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            app:layout_constraintTop_toBottomOf="@id/tv_nhan_trung_binh_buoc"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tv_khong_co_du_lieu_buoc_chan"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/khong_co_du_lieu"
            android:textColor="@color/text_secondary"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/tv_gia_tri_trung_binh_buoc"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>