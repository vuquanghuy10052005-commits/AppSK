<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_ten_mon"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_ten_mon">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_ten_mon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary" />

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_calo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/hint_calo">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_calo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:textColor="@color/text_primary" />

    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/label_loai_bua"
        android:textColor="@color/text_secondary" />

    <Spinner
        android:id="@+id/spinner_loai_bua"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:entries="@array/mang_loai_bua" />

</LinearLayout>